DEDALUS_API_KEY=dsk-live-...
DEDALUS_API_BASE=https://api.dedaluslabs.ai/v1

# Model to use (deepseek-chat by default)
OFFICEQA_MODEL=deepseek-chat

# NVIDIA provider (takes priority over Dedalus when set)
# To switch: set NVIDIA_API_KEY and optionally OFFICEQA_MODEL=minimaxai/minimax-m2.7
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
